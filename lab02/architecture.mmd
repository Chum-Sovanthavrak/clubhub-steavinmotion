
flowchart TB

    %% PRESENTATION TIER
    subgraph P[Presentation]
        CLI[C++ CLI - src/cli/]
        PWA[PWA Front End - modelled only]
    end

    %% LOGIC TIER
    subgraph L[Logic]
        API[HTTP API - production / modelled]
        CORE[clubhub_core - include/clubhub/, src/]
        RS[RegistrationService]
        ES[EventService]
    end

    %% DATA TIER
    subgraph D[Data]
        CSV[(CSV files - data/)]
        DB[(Database - planned for later)]
    end

    %% EXTERNAL SYSTEMS
    EMAIL[[E-mail service]]
    DIR[[ITC student directory]]

    %% FRONT END TO CORE
    CLI -->|direct function calls| CORE
    PWA -->|HTTPS requests| API
    API -->|core function calls| CORE

    %% CORE TO SERVICES
    CORE --> RS
    CORE --> ES

    %% LOGIC TO DATA
    RS -->|read and write registrations| CSV
    ES -->|read and write events| CSV

    %% LOGIC TO EXTERNAL SYSTEMS
    RS -->|student ID lookup| DIR
    RS -->|confirmation and reminder requests| EMAIL
    ES -->|event notification requests| EMAIL

    %% IMPLEMENTATION STATUS
    classDef implemented fill:#d5f5e3,stroke:#229954,color:#000
    classDef modelled fill:#d6eaf8,stroke:#2874a6,color:#000
    classDef planned fill:#eeeeee,stroke:#777,color:#000

    class CLI,CORE,RS,ES,CSV implemented
    class PWA,API modelled
